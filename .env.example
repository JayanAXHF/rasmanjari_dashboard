# At least 32 characters each. Generate with: openssl rand -base64 48
SCHOOL_SESSION_PASSWORD=replace-with-a-long-random-secret
ADMIN_SESSION_PASSWORD=replace-with-a-different-long-random-secret
JUDGE_SESSION_PASSWORD=replace-with-a-third-long-random-secret
# Argon2 hash, never a plaintext password. Generate with:
# node -e "import('argon2').then(({default:a})=>a.hash('choose-a-password').then(console.log))"
ADMIN_PASSWORD_HASH=replace-with-an-argon2-hash

# Private persistent paths. Production values are shown below; use absolute
# development paths outside the release directory.
DATABASE_PATH=/var/portal/data/app.db
UPLOAD_DIR=/var/portal/data/uploads
PROMPT_DIR=/var/portal/data/prompt
